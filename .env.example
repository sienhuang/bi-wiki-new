# 复制为项目根目录的 .env，并替换占位密码。不要提交 .env。
BI_WIKI_DATABASE_URL=postgresql+asyncpg://bi_wiki:replace-me@127.0.0.1:5432/bi_wiki
# 测试库必须单独创建，以 _test 结尾，不能使用运行库。
BI_WIKI_TEST_DATABASE_URL=postgresql+asyncpg://bi_wiki:replace-me@127.0.0.1:5432/bi_wiki_test
BI_WIKI_HOST=127.0.0.1
BI_WIKI_PORT=8020
BI_WIKI_LOG_LEVEL=INFO
BI_WIKI_KNOWLEDGE_ROOT=knowledge
BI_WIKI_DATABASE_TIMEOUT_SECONDS=5
BI_WIKI_INITIALIZE_DATABASE=true


# 可选文件输出；默认仅控制台。相对路径相对于启动工作目录。
# BI_WIKI_LOG_FILE=var/log/bi_wiki.jsonl
BI_WIKI_LOG_BACKUP_COUNT=7

# MOA：沿用旧 BI-WIKI 项目 ID，可按门户实际应用登记调整。仅支持 MOA，不提供 dev 免登录。
BI_WIKI_MOA_PORTAL_URL=https://login.moa.moonton.net
BI_WIKI_MOA_AUTH_URL=https://auth-api.moa.moonton.net
BI_WIKI_MOA_PROJECT_ID=1564
BI_WIKI_MOA_TIMEOUT_SECONDS=10

# Ingest v1：兼容 chat/completions 协议的模型服务。地址包含 /v1 等前缀，不含 /chat/completions。
# 未配置时不能生成计划；不会使用假模型。密钥只保存在本机环境中。
BI_WIKI_LLM_BASE_URL=
BI_WIKI_LLM_MODEL=
# BI_WIKI_LLM_API_KEY=
# 原始资料不可覆盖，默认项目根 var/raw；相对路径按项目根解析。
BI_WIKI_RAW_ROOT=var/raw

# 模型连接统一配置：openai 或 cli
BI_WIKI_LLM_PROVIDER=openai
BI_WIKI_LLM_TIMEOUT_SECONDS=300
# CLI 参数必须是 JSON 数组，不经过 Shell；{model} 替换为 LLM_MODEL。
# BI_WIKI_LLM_CLI_COMMAND=["aimana","chat","--model","{model}","--no-stream"]
BI_WIKI_INGEST_OVERHEAD_SECONDS=30
BI_WIKI_INGEST_RECOVERY_GRACE_SECONDS=60

# Raw 文件存储，默认 local；切换不会迁移旧文件
BI_WIKI_RAW_BACKEND=local
# BI_WIKI_S3_BUCKET=your-existing-bucket
# BI_WIKI_S3_PREFIX=bi-wiki/raw
# BI_WIKI_S3_REGION=us-east-1
# AWS S3 留空；兼容服务填写 endpoint，例如本机 MinIO
# BI_WIKI_S3_ENDPOINT_URL=http://127.0.0.1:9000
# BI_WIKI_S3_ADDRESSING_STYLE=path
# 不填显式凭据时使用 boto3 标准凭据链（IAM role / AWS 环境变量等）
# BI_WIKI_S3_ACCESS_KEY=
# BI_WIKI_S3_SECRET_KEY=
# BI_WIKI_S3_SESSION_TOKEN=
